{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/post-commit-validate.mjs",
            "if": "Bash(git *)",
            "timeout": 60,
            "statusMessage": "커밋 후 가드레일 테스트 실행 중…"
          }
        ]
      }
    ]
  }
}

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pre-commit-review.mjs",
            "if": "Bash(git *)",
            "timeout": 30,
            "statusMessage": "커밋 전 자동 코드 리뷰 준비 중…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/post-commit-validate.mjs",
            "if": "Bash(git *)",
            "timeout": 60,
            "statusMessage": "커밋 후 가드레일 테스트 실행 중…"
          }
        ]
      }
    ]
  }
}

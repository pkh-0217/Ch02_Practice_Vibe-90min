# ─────────────────────────────────────────────
# 환경 변수 템플릿 (.env.example)
# ─────────────────────────────────────────────
# 사용법:
#   1) 이 파일을 복사해서 .env 파일을 만드세요.   cp .env.example .env
#   2) .env 에 실제 값을 채우세요.
#   3) .env 는 .gitignore 에 의해 커밋되지 않습니다 (비밀값 보호).
#
# ⚠️ 현재 index.html(정적 웹앱)은 API 키를 브라우저 localStorage에서 읽습니다.
#    이 .env 는 추후 빌드/백엔드 도입 시 사용할 자리표시자입니다.

# Anthropic API 키 (https://console.anthropic.com/settings/keys 에서 발급)
ANTHROPIC_API_KEY=sk-ant-...

# 사용할 모델 (예: claude-haiku-4-5-20251001 / claude-sonnet-4-6 / claude-opus-4-8)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
